---
import KnowledgeHub from "@components/features/KnowledgeHub.astro";
import catalog from "../../data/portswigger-labs.json";

const sections = catalog.map((group) => ({
	title: group.name,
	description: `Browse ${group.topics.length} topics in the official PortSwigger learning order.`,
	links: group.topics.map((topic) => ({
		title: topic.title,
		href: `/academy/${topic.slug}/`,
		description: `${topic.labs.length} labs`,
		icon: "material-symbols:bug-report-outline",
	})),
}));
---
<KnowledgeHub title="PortSwigger Academy Labs" description="A structured index of official Web Security Academy topics and labs." eyebrow="WEB SECURITY // PORTSWIGGER ACADEMY" sections={sections} />
