---
import KnowledgeHub from "@components/features/KnowledgeHub.astro";
import catalog from "../../data/portswigger-labs.json";
export function getStaticPaths() {
	return catalog.flatMap((group) =>
		group.topics.map((topic) => ({ params: { topic: topic.slug }, props: { topic, groupName: group.name } })),
	);
}
const { topic, groupName } = Astro.props;
const sections = [{
	title: `${topic.labs.length} Labs`,
	description: "Open any lab on the official PortSwigger Web Security Academy.",
	links: topic.labs.map((lab) => ({
		title: lab.title,
		href: lab.url,
		icon: "material-symbols:science-outline",
		external: true,
	})),
}];
---
<KnowledgeHub title={topic.title} description={`Official PortSwigger Academy ${topic.title} labs.`} eyebrow={`PORTSWIGGER ACADEMY // ${groupName.toUpperCase()}`} sections={sections} share />
