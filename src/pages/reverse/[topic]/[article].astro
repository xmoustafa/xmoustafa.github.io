---
import ShareCard from "@components/features/posts/ShareCard.astro";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection, render } from "astro:content";
import { profileConfig, shareConfig, siteConfig } from "../../../config";
import { slugifyKnowledgeTitle } from "../../../utils/academy";

export async function getStaticPaths() {
	const articles = await getCollection("reverse", ({ data }) => !data.draft);
	return articles.map((entry) => ({
		params: {
			topic: slugifyKnowledgeTitle(entry.data.topic),
			article: entry.id.split("/").at(-1),
		},
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<MainGridLayout title={entry.data.title} description={entry.data.description}>
	<article class="reverse-article card-base p-6 md:p-9">
		<header>
			<a href="/reverse/">&larr; Reverse</a>
			<span>REVERSE ENGINEERING // {entry.data.topic}</span>
			<h1>{entry.data.title}</h1>
			{entry.data.description && <p>{entry.data.description}</p>}
		</header>

		<Markdown class="article-content prose dark:prose-invert max-w-none">
			<Content />
		</Markdown>

		{shareConfig.enable && (
			<ShareCard
				title={entry.data.title}
				description={entry.data.description}
				pubDate="2026-08-03"
				url={Astro.url.toString()}
				siteTitle={siteConfig.title}
				avatar={profileConfig.avatar}
				class="mt-8 mb-0"
			/>
		)}
	</article>
</MainGridLayout>

<style is:global>
	body:has(.reverse-article) #main-grid { grid-template-columns: minmax(0, 1fr) !important; max-width: 78rem; }
	body:has(.reverse-article) #main-grid > .contents { display: none; }
	body:has(.reverse-article) #swup-container { grid-column: 1 / -1 !important; }
	.reverse-article { color: #17211b; border: 1px solid color-mix(in srgb, var(--primary) 38%, transparent); }
	.reverse-article > header { padding-left: 1.25rem; border-left: 4px solid var(--primary); }
	.reverse-article > header a { color: var(--primary); font-weight: 700; text-decoration: none; }
	.reverse-article > header span { display: block; margin-top: 1rem; color: var(--primary); font: 700 .72rem var(--font-jetbrains-mono), monospace; letter-spacing: .12em; }
	.reverse-article > header h1 { margin: .55rem 0 .35rem; color: #101a13; font-size: clamp(1.8rem, 4vw, 3rem); }
	.reverse-article > header p { color: #526158; }
	.article-content { min-height: 14rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid color-mix(in srgb, var(--primary) 22%, transparent); }
	:root.dark .reverse-article { color: #e7f4eb; background: linear-gradient(145deg, rgba(20, 31, 24, .98), rgba(12, 22, 16, .98)) !important; border-color: color-mix(in srgb, var(--primary) 45%, transparent) !important; }
	:root.dark .reverse-article > header h1 { color: #f1faf4; }
	:root.dark .reverse-article > header p { color: #a8b8ad; }
</style>
